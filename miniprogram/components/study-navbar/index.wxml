<view class="navbar theme-{{theme}}" style="padding-top: {{statusHeight}}px;">
  <view class="bar" style="height: {{barHeight}}px;">
    <view wx:if="{{back}}" class="back-hit" role="button" aria-label="返回" bindtap="goBack"><view class="chevron"></view></view>
    <view wx:if="{{theme === 'paper'}}" class="home-brand" style="padding-right: {{rightSpace}}px;">
      <text class="brand-title">{{title}}</text>
      <text wx:if="{{region}}" class="region">{{region}}</text>
    </view>
    <view wx:else class="title-wrap" style="padding-left: {{rightSpace}}px; padding-right: {{rightSpace}}px;"><text class="title">{{title}}</text></view>
  </view>
</view>
