:host { display: block; }
.card { position: relative; padding: 28rpx 26rpx 8rpx; border: 1px solid #EAEBE6; border-radius: 32rpx; background: #FFFFFF; box-shadow: 0 5rpx 18rpx rgba(27,77,62,.035); box-sizing: border-box; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.question-line { display: flex; align-items: flex-start; padding-right: 48rpx; }
.number { flex-shrink: 0; min-width: 42rpx; height: 48rpx; margin-top: 3rpx; margin-right: 18rpx; border-radius: 12rpx; background: #ECF2E9; color: #1B4D3E; font-family: "Songti SC", STSong, SimSun, serif; font-size: 30rpx; font-weight: 700; line-height: 48rpx; text-align: center; }
.question-content { flex: 1; min-width: 0; }
.stem { color: #242A27; font-size: 32rpx; line-height: 1.75; word-break: break-all; white-space: pre-line; }
.answer { padding: 2rpx 9rpx; border-bottom: 1px solid #66805B; border-radius: 6rpx; background: #E9F0E4; color: #1B4D3E; font-weight: 600; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
.answer-compact { white-space: nowrap; }
.star-hit { position: absolute; top: 8rpx; right: 2rpx; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; color: #B8BDB8; }
.star { font-size: 42rpx; line-height: 1; }
.star-hit.selected { color: #C47A2B; }
.tag { display: block; margin: 0 0 8rpx; color: #707870; font-size: 25rpx; line-height: 1.6; }
.card-footer { display: flex; justify-content: flex-end; margin-top: 20rpx; border-top: 1px dashed #ECEEE9; }
.master-hit { display: flex; align-items: center; justify-content: flex-end; min-height: 80rpx; min-width: 172rpx; padding-left: 20rpx; }
.master { display: flex; align-items: center; justify-content: center; min-height: 48rpx; padding: 4rpx 18rpx; border: 1px solid #DDE1DC; border-radius: 30rpx; color: #5C6460; background: #FCFCFB; font-size: 24rpx; line-height: 1.4; white-space: nowrap; }
.master-symbol { margin-right: 12rpx; font-size: 28rpx; line-height: 1; }
.mastered { border-color: #A6CEB5; background: #F3FBF6; color: #286D4E; }
.original { font-weight: 500; }
.translation-answer { margin-top: 22rpx; padding: 20rpx 24rpx; border-radius: 12rpx; background: #EDF2EB; }
.answer-caption { display: block; margin-bottom: 8rpx; color: #758074; font-size: 25rpx; line-height: 1.5; }
.translation-text { display: block; color: #1B4D3E; font-size: 33rpx; line-height: 1.75; word-break: break-all; }
.translation-recall { margin-top: 22rpx; padding: 20rpx 24rpx 22rpx; border-radius: 12rpx; background: #F7F8F5; }
.recall-line { height: 28rpx; border-bottom: 1px solid #C5CEC3; }
.recall-line.short { width: 72%; margin-top: 12rpx; }
