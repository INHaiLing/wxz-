:host { display: block; }
.modes { display: flex; align-items: center; width: 100%; height: 88rpx; padding: 8rpx; border-radius: 24rpx; background: #E5EBE4; box-sizing: border-box; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.mode { flex: 1; min-width: 0; height: 72rpx; display: flex; justify-content: center; align-items: center; border-radius: 18rpx; color: #505A53; font-size: 30rpx; font-weight: 500; line-height: 1.2; white-space: nowrap; box-sizing: border-box; }
.mode + .mode { margin-left: 8rpx; }
.active { background: #13382D; color: #FFFFFF; box-shadow: 0 3rpx 9rpx rgba(27,77,62,.14); }
.mode-icon { position: relative; flex-shrink: 0; width: 28rpx; height: 28rpx; margin-right: 14rpx; box-sizing: border-box; }
.writing-icon { width: 25rpx; height: 24rpx; border: 2rpx solid currentColor; border-radius: 5rpx; }
.pencil { position: absolute; width: 22rpx; height: 5rpx; top: 2rpx; right: -7rpx; border: 2rpx solid currentColor; border-radius: 2rpx; transform: rotate(-45deg); background: #E5EBE4; }
.active .pencil { background: #13382D; }
.reading-icon { display: flex; align-items: center; }
.book-left, .book-right { width: 14rpx; height: 24rpx; border: 2rpx solid currentColor; box-sizing: border-box; }
.book-left { border-radius: 5rpx 2rpx 0 3rpx; transform: skewY(8deg); }
.book-right { border-left: 0; border-radius: 2rpx 5rpx 3rpx 0; transform: skewY(-8deg); }
