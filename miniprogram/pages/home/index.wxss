page,
.home-page {
  min-height: 100vh;
  background: #F7F8F5;
  color: #242A27;
}

.home-body {
  padding: 28rpx 26rpx calc(172rpx + env(safe-area-inset-bottom));
}

.overview-card {
  position: relative;
  padding: 28rpx 32rpx 32rpx;
  overflow: hidden;
  border: 1rpx solid #E6E8E2;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(27, 77, 62, 0.035);
  background: #FFFFFF;
}

.overview-watermark {
  position: absolute;
  right: -12rpx;
  bottom: -36rpx;
  color: #F0F5F1;
  font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif;
  font-size: 210rpx;
  font-weight: 700;
  line-height: 1;
  pointer-events: none;
}

.greeting-row {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  min-height: 124rpx;
}

.greeting {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.hello-badge {
  display: inline-flex;
  align-items: center;
  gap: 9rpx;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  color: #A76320;
  background: #FAF3E0;
  font-size: 24rpx;
  line-height: 1.4;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C47A2B;
}

.greeting-title {
  margin-top: 16rpx;
  font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.countdown-card {
  flex-shrink: 0;
  padding-top: 1rpx;
  text-align: right;
}

.countdown-caption {
  display: block;
  color: #5C6460;
  font-size: 24rpx;
  line-height: 1.5;
}

.countdown-value {
  margin-top: 3rpx;
  color: #C47A2B;
  line-height: 1.2;
}

.countdown-number {
  font-size: 66rpx;
  font-weight: 500;
  font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif;
  font-variant-numeric: tabular-nums;
}

.countdown-unit {
  margin-left: 6rpx;
  font-size: 24rpx;
}

.overview-divider {
  height: 1rpx;
  margin: 22rpx 0 26rpx;
  background: #EDF0EA;
}

.stats-row {
  position: relative;
  display: flex;
  align-items: center;
}

.stat {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.stat-middle {
  border-right: 1rpx solid #EDF0EA;
  border-left: 1rpx solid #EDF0EA;
}

.stat-value {
  color: #1B4D3E;
  font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif;
  font-size: 50rpx;
  font-weight: 600;
  line-height: 1.15;
}

.stat-middle .stat-value { color: #242A27; }
.stat-unit { margin-left: 4rpx; color: #5C6460; font-size: 24rpx; font-weight: 400; }
.stat-label { display: block; margin-top: 10rpx; color: #5C6460; font-size: 25rpx; line-height: 1.4; }

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin: 32rpx 4rpx 22rpx;
}

.section-title { display: flex; align-items: center; gap: 13rpx; font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif; font-size: 32rpx; font-weight: 700; }
.section-mark { width: 7rpx; height: 30rpx; border-radius: 6rpx; background: #1B4D3E; }
.section-caption { color: #5C6460; font-size: 22rpx; white-space: nowrap; }
.module-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }

.entry-card {
  box-sizing: border-box;
  flex: 0 0 48.5%;
  width: 48.5%;
  min-width: 0;
  padding: 22rpx 28rpx 20rpx;
  border: 1rpx solid #E6E8E2;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 22rpx rgba(27, 77, 62, 0.035);
  background: #FFFFFF;
}

.entry-card:nth-child(n + 3) { margin-top: 18rpx; }

.entry-icon { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-bottom: 12rpx; border: 1rpx solid #DFEAE4; border-radius: 22rpx; background: #F0F6F2; }
.amber-icon { border-color: #F4E7CF; background: #FAF3E0; }
.neutral-icon { border-color: #E6E8E2; background: #F5F6F3; }
.entry-title { display: block; font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.entry-description { display: block; margin-top: 6rpx; color: #5C6460; font-size: 24rpx; line-height: 1.5; white-space: nowrap; }
.entry-footer { display: flex; justify-content: space-between; align-items: center; min-height: 37rpx; margin-top: 17rpx; padding-top: 12rpx; border-top: 1rpx solid #EDF0EA; color: #5C6460; font-size: 23rpx; line-height: 1.5; }
.entry-total { display: flex; align-items: baseline; gap: 10rpx; }
.total-number { color: #1B4D3E; font-size: 27rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.sample-count { font-size: 21rpx; }
.entry-chevron { width: 12rpx; height: 12rpx; border-top: 2rpx solid #5C6460; border-right: 2rpx solid #5C6460; transform: rotate(45deg); }

.favorites-card { display: flex; align-items: center; gap: 24rpx; margin-top: 20rpx; padding: 22rpx 28rpx; border: 1rpx solid #E6E8E2; border-radius: 28rpx; box-shadow: 0 6rpx 22rpx rgba(27, 77, 62, 0.035); background: #FFFFFF; }
.favorites-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 86rpx; height: 86rpx; border-radius: 23rpx; background: #FAF3E0; }
.favorites-copy { display: flex; flex: 1; flex-direction: column; gap: 6rpx; min-width: 0; }
.favorites-title { font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif; font-size: 31rpx; font-weight: 700; line-height: 1.4; }
.favorites-description { color: #5C6460; font-size: 24rpx; line-height: 1.45; }
.favorites-chevron { flex-shrink: 0; margin-right: 9rpx; }

.today-dock { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(247, 248, 245, 0), rgba(247, 248, 245, 0.95) 30%); }
.today-card { display: flex; align-items: center; gap: 28rpx; padding: 20rpx 26rpx; border: 1rpx solid #E6E8E2; border-radius: 32rpx; box-shadow: 0 8rpx 36rpx rgba(27, 77, 62, 0.09); background: #FFFFFF; }
.today-copy { flex: 1; min-width: 0; }
.today-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 8rpx; color: #5C6460; font-size: 22rpx; line-height: 1.5; white-space: nowrap; }
.today-number { color: #1B4D3E; font-weight: 600; font-size: 25rpx; }
.today-track { height: 12rpx; margin-top: 12rpx; overflow: hidden; border-radius: 10rpx; background: #F0F2EE; }
.today-progress { height: 100%; border-radius: inherit; background: #1B4D3E; }
.continue-button { display: flex; align-items: center; justify-content: center; gap: 15rpx; flex-shrink: 0; min-height: 82rpx; padding: 0 28rpx; border-radius: 22rpx; color: #FFFFFF; background: #1B4D3E; box-shadow: 0 6rpx 16rpx rgba(27, 77, 62, 0.17); font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif; font-size: 29rpx; font-weight: 600; line-height: 1.4; }
.button-arrow { font-family: sans-serif; font-size: 36rpx; font-weight: 400; }
.entry-pressed { background: #F0F5F1; }
.continue-pressed { background: #13382D; }
