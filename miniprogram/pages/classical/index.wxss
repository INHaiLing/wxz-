page { background: #F7F8F5; }
.classical-page { min-height: 100vh; color: #242A27; background: #F7F8F5; }
.classical-body { padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom)); }
.summary-card { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 204rpx; padding: 28rpx; border: 1rpx solid #E6E8E2; border-radius: 28rpx; background: #FFFFFF; box-shadow: 0 6rpx 24rpx rgba(27, 77, 62, .035); }
.summary-copy { flex: 1; min-width: 0; }
.summary-region { display: inline-block; padding: 6rpx 14rpx; border-radius: 10rpx; background: #FAF3E0; color: #9D692B; font-size: 22rpx; line-height: 1.4; }
.summary-title { display: block; margin-top: 18rpx; font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif; font-size: 34rpx; line-height: 1.5; font-weight: 700; letter-spacing: 1rpx; color: #1B4D3E; }
.summary-caption { display: block; margin-top: 10rpx; color: #747C76; font-size: 23rpx; line-height: 1.6; }
.ring-area { position: relative; flex-shrink: 0; width: 152rpx; height: 152rpx; }
.progress-ring { width: 152rpx; height: 152rpx; }
.ring-label { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: #1B4D3E; pointer-events: none; }
.ring-value { font-family: Georgia, "Songti SC", serif; font-size: 42rpx; font-weight: 700; }
.ring-total { color: #747C76; font-size: 23rpx; }
.ring-caption { color: #747C76; font-size: 20rpx; line-height: 1.5; }
.specialties { display: flex; gap: 18rpx; margin: 20rpx 0 34rpx; }
.specialty-card { display: flex; align-items: center; flex: 1; min-width: 0; gap: 14rpx; padding: 24rpx 18rpx; border: 1rpx solid #E6E8E2; border-radius: 24rpx; background: #FFFFFF; box-shadow: 0 4rpx 16rpx rgba(27, 77, 62, .025); }
.specialty-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 60rpx; height: 66rpx; border-radius: 16rpx; color: #1B4D3E; background: #EDF4EF; }
.specialty-icon-amber { background: #FAF3E0; }
.specialty-copy { flex: 1; min-width: 0; }
.specialty-title { display: block; font-size: 28rpx; line-height: 1.4; font-weight: 600; }
.specialty-caption { display: block; margin-top: 6rpx; font-size: 19rpx; line-height: 1.5; color: #747C76; white-space: nowrap; }
.specialty-chevron { color: #929A94; font-size: 32rpx; }
.catalog-heading { display: flex; justify-content: space-between; align-items: center; margin: 0 8rpx 20rpx; }
.catalog-title { padding-left: 18rpx; border-left: 6rpx solid #1B4D3E; font-size: 32rpx; font-weight: 700; line-height: 1.2; }
.catalog-count { color: #747C76; font-size: 23rpx; }
.filter-tabs { display: flex; gap: 14rpx; margin-bottom: 22rpx; }
.filter-tab { flex: 1; display: flex; align-items: center; justify-content: center; min-width: 0; height: 60rpx; padding: 0 14rpx; border: 1rpx solid #E6E8E2; border-radius: 40rpx; color: #5C6460; background: #FFFFFF; font-size: 26rpx; line-height: 1.4; }
.filter-tab.is-active { border-color: #1B4D3E; color: #FFFFFF; background: #1B4D3E; font-weight: 600; }
.catalog-card { overflow: hidden; padding: 0 24rpx; border: 1rpx solid #E6E8E2; border-radius: 28rpx; background: #FFFFFF; box-shadow: 0 6rpx 24rpx rgba(27, 77, 62, .025); }
.article-row { display: flex; align-items: center; gap: 18rpx; min-height: 128rpx; padding: 24rpx 0; border-bottom: 1rpx solid #EFF0EC; }
.article-row:last-child { border-bottom: 0; }
.article-number { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 50rpx; height: 54rpx; border-radius: 13rpx; color: #1B4D3E; background: #EEF3EC; font-family: Georgia, "Songti SC", serif; font-size: 29rpx; line-height: 1; font-weight: 700; }
.number-learned { background: #DDEBDF; }
.article-copy { flex: 1; min-width: 0; }
.article-title { display: block; font-size: 32rpx; line-height: 1.5; color: #242A27; }
.article-detail { display: block; margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; color: #858B86; }
.article-status { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 10rpx; font-size: 21rpx; line-height: 1.4; }
.status-unlearned { color: #7B827D; background: #F3F4F0; }
.status-learning { color: #9D692B; background: #FAF3E0; }
.status-learned { color: #388E3C; background: #EEF5EB; }
.article-chevron { flex-shrink: 0; color: #919993; font-size: 34rpx; line-height: 1; }
.is-placeholder .article-title { color: #7B827D; font-size: 28rpx; }
.demo-note { display: block; margin: 24rpx 8rpx 0; color: #919993; font-size: 22rpx; text-align: center; line-height: 1.5; }
.catalog-footer { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 116rpx; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border: 1rpx solid #E6E8E2; border-bottom: 0; border-radius: 30rpx 30rpx 0 0; background: rgba(255, 255, 255, .98); box-shadow: 0 -8rpx 32rpx rgba(27, 77, 62, .04); }
.continue-caption { min-width: 0; }
.continue-title { display: block; color: #5C6460; font-size: 26rpx; line-height: 1.5; }
.continue-subtitle { display: block; margin-top: 4rpx; color: #929A94; font-size: 21rpx; line-height: 1.5; }
.continue-button { display: flex; align-items: center; justify-content: center; gap: 16rpx; flex-shrink: 0; min-width: 240rpx; height: 80rpx; padding: 0 26rpx; border: 1rpx solid #1B4D3E; border-radius: 22rpx; color: #FFFFFF; background: linear-gradient(120deg, #1B4D3E, #13382D); box-shadow: 0 6rpx 14rpx rgba(27, 77, 62, .13); font-size: 30rpx; font-weight: 600; line-height: 1.3; }
.button-arrow { font-size: 36rpx; font-weight: 400; line-height: 1; }
.button-pressed { background: #13382D; opacity: .9; }
.card-pressed { opacity: .72; }
.modal-mask { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(19, 36, 28, .38); }
.article-dialog { position: relative; box-sizing: border-box; width: 100%; max-width: 620rpx; padding: 48rpx 36rpx 36rpx; border: 1rpx solid #E6E8E2; border-radius: 32rpx; background: #FFFFFF; box-shadow: 0 24rpx 80rpx rgba(19, 56, 45, .18); }
.dialog-close { position: absolute; top: 16rpx; right: 16rpx; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; color: #747C76; font-size: 42rpx; line-height: 1; }
.dialog-kicker { display: block; padding: 0 36rpx; text-align: center; color: #9D692B; font-size: 23rpx; line-height: 1.5; }
.dialog-title { display: block; margin-top: 18rpx; color: #1B4D3E; font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif; text-align: center; font-size: 42rpx; font-weight: 700; line-height: 1.5; }
.dialog-description { display: block; margin-top: 12rpx; text-align: center; color: #747C76; font-size: 26rpx; line-height: 1.6; }
.dialog-actions { display: flex; flex-direction: column; gap: 18rpx; margin-top: 34rpx; }
.dialog-button { display: flex; align-items: center; gap: 20rpx; min-height: 92rpx; padding: 0 26rpx; border: 1rpx solid #1B4D3E; border-radius: 22rpx; background: #1B4D3E; color: #FFFFFF; font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.translation-button { color: #1B4D3E; background: #EDF3EE; border-color: #D9E5DA; }
.dialog-arrow { margin-left: auto; font-size: 36rpx; font-weight: 400; }
