<view class="random-page">
  <study-navbar title="{{source === 'classical' ? '文言随机测' : '文常随机练'}}" theme="emerald" back="{{true}}" />
  <view class="random-content">
    <view class="random-summary">
      <view class="summary-icon" aria-hidden="true"><study-icon name="dice" size="42" color="#C47A2B" /></view>
      <view class="summary-copy">
        <text class="summary-title">{{sourceName}} · 随机巩固</text>
        <text class="summary-description">{{subtitle}}</text>
      </view>
      <view class="summary-count"><text class="summary-value">5</text><text class="summary-unit">每组最多题数</text></view>
    </view>
    <view class="random-mode">
      <mode-switch mode="{{mode}}" theme="emerald" bindchange="onModeChange" />
    </view>
    <view class="round-caption" wx:if="{{questions.length}}">
      <text>本轮共 {{roundQuestionCount}} 题 · 本组 {{questions.length}} 题</text>
      <text class="round-hint">温故而知新</text>
    </view>
    <view class="random-questions" wx:if="{{questions.length}}">
      <view class="random-question" wx:for="{{questions}}" wx:key="id">
        <question-card question="{{item}}" mode="{{mode}}" number="{{index + 1}}" variant="random" show-tag="{{true}}" bindfavorite="onFavorite" bindmaster="onMaster" />
      </view>
    </view>
    <empty-state wx:else title="暂无随机练习题" description="该模块暂无演示内容，题库后续补充。" action-text="去学习" bindaction="onGoStudy" />
  </view>
  <view class="random-footer" wx:if="{{questions.length}}">
    <view class="group-counter">第 <text class="counter-current">{{groupNumber}}</text> 组 / 共 {{groupCount}} 组</view>
    <view class="next-group" role="button" aria-label="{{nextLabel}}" hover-class="next-group-pressed" bindtap="onNextGroup"><text>{{nextLabel}}</text><text class="button-arrow" aria-hidden="true">→</text></view>
  </view>
</view>
