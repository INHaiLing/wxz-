page { background: #f7f8f5; }

.random-page { min-height: 100vh; background: #f7f8f5; }
.random-content { padding: 24rpx 24rpx 152rpx; padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); }
.random-summary { display: flex; align-items: center; min-height: 144rpx; padding: 24rpx; border: 1px solid #e6e8e2; border-radius: 24rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(27,77,62,.035); }
.summary-icon { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-right: 20rpx; border-radius: 22rpx; background: #faf3e0; }
.summary-copy { flex: 1; min-width: 0; }
.summary-title { display: block; color: #1b4d3e; font-family: "Noto Serif SC", "Songti SC", "STSong", serif; font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.summary-description { display: block; margin-top: 8rpx; color: #5c6460; font-size: 23rpx; line-height: 1.5; }
.summary-count { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; margin-left: 16rpx; padding-left: 20rpx; border-left: 1px solid #edf0e9; }
.summary-value { color: #c47a2b; font-family: Georgia, "Times New Roman", serif; font-size: 42rpx; line-height: 1.1; }
.summary-unit { margin-top: 8rpx; color: #5c6460; font-size: 19rpx; line-height: 1.4; }
.random-mode { margin-top: 24rpx; }
.round-caption { display: flex; align-items: center; justify-content: space-between; margin: 22rpx 4rpx; color: #5c6460; font-size: 23rpx; line-height: 1.5; }
.round-hint { color: #8a6b43; }
.random-question + .random-question { margin-top: 20rpx; }
.random-footer { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; padding: 18rpx 36rpx 22rpx; padding-bottom: calc(22rpx + env(safe-area-inset-bottom)); border-top: 1px solid #edf0e9; border-radius: 30rpx 30rpx 0 0; background: rgba(255,255,255,.98); box-shadow: 0 -6rpx 28rpx rgba(27,77,62,.035); }
.group-counter { color: #5c6460; font-size: 24rpx; line-height: 1.5; white-space: nowrap; }
.counter-current { color: #1b4d3e; font-family: Georgia, "Times New Roman", serif; font-size: 30rpx; font-weight: 600; }
.next-group { display: flex; flex-shrink: 0; align-items: center; justify-content: center; min-width: 240rpx; min-height: 80rpx; margin-left: 20rpx; padding: 16rpx 28rpx; border: 1px solid #13382d; border-radius: 22rpx; color: #fff; background: linear-gradient(115deg,#1b4d3e,#13382d); box-shadow: 0 5rpx 14rpx rgba(27,77,62,.14); font-size: 29rpx; font-weight: 600; line-height: 1.4; }
.next-group-pressed { opacity: .86; }
.button-arrow { margin-left: 16rpx; font-size: 34rpx; font-weight: 400; line-height: 1; }
