DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-private-random-key-at-least-50-characters
DJANGO_ALLOWED_HOSTS=example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.invalid
TRUSTED_PROXY_IPS=127.0.0.1
DB_ENGINE=postgresql
DB_NAME=chinese_study
DB_USER=chinese_study
DB_PASSWORD=replace-with-private-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
STUDENT_SESSION_ENCRYPTION_KEYS=replace-with-private-fernet-key
WECHAT_APP_ID=
WECHAT_APP_SECRET=
VIRTUAL_PAYMENT_ENABLED=false
VIRTUAL_PAYMENT_ANDROID_ENABLED=false
VIRTUAL_PAYMENT_IOS_ENABLED=false
# Fill the P09/P10 keys from backend/.env.example only after channel acceptance.
