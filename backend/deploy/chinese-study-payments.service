[Unit]
Description=Chinese study durable payment tasks
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=chinese-study
Group=chinese-study
WorkingDirectory=/srv/chinese-study/current/backend
EnvironmentFile=/etc/chinese-study/backend.env
Environment=DJANGO_SETTINGS_MODULE=config.production_settings
ExecStart=/srv/chinese-study/venv/bin/python manage.py run_payment_tasks --limit 50
TimeoutStartSec=600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chinese-study
