[Unit]
Description=Chinese study backend
After=network.target postgresql.service

[Service]
Type=simple
User=chinese-study
Group=chinese-study
WorkingDirectory=/srv/chinese-study/current/backend
EnvironmentFile=/etc/chinese-study/backend.env
Environment=DJANGO_SETTINGS_MODULE=config.production_settings
ExecStartPre=/srv/chinese-study/venv/bin/python manage.py check --deploy --fail-level WARNING
ExecStartPre=/srv/chinese-study/venv/bin/python manage.py migrate --check
ExecStart=/srv/chinese-study/venv/bin/gunicorn config.wsgi:application --config deploy/gunicorn.conf.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chinese-study

[Install]
WantedBy=multi-user.target
