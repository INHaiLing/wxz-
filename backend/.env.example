# setup.ps1 creates .env with a random local secret; never commit .env.
DJANGO_SECRET_KEY=replace-with-generated-secret-at-least-32-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# PostgreSQL 16 and psycopg are validated by CI; use isolated credentials.
# DB_ENGINE=postgresql
# DB_NAME=chinese_study
# DB_USER=chinese_study
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.example.com

# Student identity. Never put actual secrets in source or API examples.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Generate a Fernet key; comma-separated old keys may be retained for rotation.
STUDENT_SESSION_ENCRYPTION_KEYS=
VIRTUAL_PAYMENT_ENABLED=false
VIRTUAL_PAYMENT_IOS_ENABLED=false
# Only configured proxy peers may supply X-Real-IP.
TRUSTED_PROXY_IPS=
